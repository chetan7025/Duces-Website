<style>
:root {
  --navy:#101d35;
  --blue:#1c3558;
  --gold:#c9a45c;
  --white:#fff;
  --light:#f5f7fa;
  --text:#263247;
  --muted:#68758a;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Arial,sans-serif;color:var(--text);line-height:1.65}
.container{width:92%;max-width:1100px;margin:auto}
header{background:var(--navy);color:white;padding:16px 0}
nav{display:flex;justify-content:space-between;align-items:center;gap:15px}
.logo{font-size:23px;font-weight:bold;letter-spacing:3px;color:var(--gold)}
.logo small{display:block;font-size:9px;letter-spacing:2px;color:white}
nav a{color:white;text-decoration:none;font-size:13px;margin-left:15px}
.hero{background:linear-gradient(120deg,var(--navy),var(--blue));color:white;padding:90px 0}
.eyebrow{color:var(--gold);font-weight:bold;letter-spacing:3px;font-size:12px}
h1{font-size:clamp(38px,6vw,62px);line-height:1.15;margin:18px 0}
.hero p{font-size:17px;color:#dce3ed;max-width:650px}
.btn{display:inline-block;padding:13px 22px;background:var(--gold);color:var(--navy);text-decoration:none;font-weight:bold;border-radius:4px;margin:12px 8px 0 0}
.btn.outline{background:transparent;border:1px solid var(--gold);color:white}
section{padding:70px 0}
.heading{text-align:center;max-width:700px;margin:0 auto 38px}
.heading h2{font-size:34px;color:var(--navy);line-height:1.2}
.heading p{color:var(--muted)}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{padding:25px;border:1px solid #e4e8ef;border-radius:6px;background:white}
.card h3{color:var(--navy);margin:8px 0}
.card p{font-size:14px;color:var(--muted)}
.number{color:var(--gold);font-weight:bold;font-size:12px}
.about{background:var(--light)}
.aboutbox{background:var(--navy);color:white;padding:35px;border-radius:7px}
.aboutbox h3{color:var(--gold);font-size:26px}
.aboutgrid{display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center}
.aboutgrid p{color:var(--muted)}
.aboutbox p{color:#dce3ed}
.contact{background:var(--navy);color:white}
.contact h2{font-size:36px}
.contact p{color:#dce3ed}
.contactbox{background:white;color:var(--navy);padding:28px;border-radius:7px}
.contactbox a{color:var(--navy);font-size:20px;font-weight:bold}
footer{background:#091326;color:#c4ccda;padding:25px 0;font-size:12px}
footer p{color:#aeb9ca;font-size:11px}
@media(max-width:750px){
 nav{flex-wrap:wrap}
 nav div:last-child{width:100%;display:flex;gap:12px;flex-wrap:wrap}
 nav a{margin:0}
 .cards{grid-template-columns:1fr}
 .aboutgrid{grid-template-columns:1fr}
 .hero{padding:65px 0}
 section{padding:55px 0}
}
</style>
</head>
